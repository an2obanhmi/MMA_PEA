rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kiểm tra tính hợp lệ của dữ liệu phim theo yêu cầu Section 2.2
    function isValidMovie(movie) {
      return movie.userId == request.auth.uid
        // title bắt buộc, không được chỉ chứa khoảng trắng, tối đa 100 ký tự
        && movie.title is string 
        && movie.title.matches('.*[^ \t\r\n].*')
        && movie.title.size() <= 100
        // director bắt buộc, không được chỉ chứa khoảng trắng, tối đa 60 ký tự
        && movie.director is string 
        && movie.director.matches('.*[^ \t\r\n].*')
        && movie.director.size() <= 60
        // genre phải thuộc 1 trong 4 thể loại
        && movie.genre in ['Action', 'Comedy', 'Drama', 'Horror']
        // status phải thuộc 1 trong 3 trạng thái
        && movie.status in ['Plan to Watch', 'Watching', 'Watched']
        // rating: tuỳ chọn, nếu có phải là số nguyên từ 0 đến 5
        && (!('rating' in movie) || movie.rating == null || (movie.rating is int && movie.rating >= 0 && movie.rating <= 5))
        // notes: tuỳ chọn, nếu có tối đa 300 ký tự
        && (!('notes' in movie) || movie.notes == null || (movie.notes is string && movie.notes.size() <= 300))
        // favorite: tuỳ chọn, nếu có phải là boolean
        && (!('favorite' in movie) || movie.favorite is bool);
    }

    match /movies/{movieId} {
      // 1. Chỉ người dùng đã đăng nhập mới được đọc các hàng của chính mình
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // 2. Thêm mới: phải đăng nhập, đúng userId của chính mình và dữ liệu hợp lệ
      allow create: if request.auth != null 
        && isValidMovie(request.resource.data);
      
      // 3. Sửa: chỉ người sở hữu bản ghi mới được sửa và dữ liệu mới phải hợp lệ
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && isValidMovie(request.resource.data);
      
      // 4. Xóa: chỉ người sở hữu bản ghi mới được xóa
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
  }
}
