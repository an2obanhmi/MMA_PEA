rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra tính hợp lệ của dữ liệu phim
    function isValidMovie(movie) {
      return movie.userId == request.auth.uid
        && movie.title is string 
        && movie.title.trim().size() > 0 
        && movie.title.size() <= 100
        && movie.director is string 
        && movie.director.trim().size() > 0 
        && movie.director.size() <= 60
        && movie.genre in ['Action', 'Comedy', 'Drama', 'Horror']
        && movie.status in ['Plan to Watch', 'Watching', 'Watched']
        && (!('rating' in movie) || movie.rating == null || (movie.rating is int && movie.rating >= 0 && movie.rating <= 5))
        && (!('notes' in movie) || movie.notes == null || (movie.notes is string && movie.notes.size() <= 300))
        && (!('favorite' in movie) || movie.favorite is bool);
    }

    match /movies/{movieId} {
      // Chỉ cho phép đọc nếu người dùng đã đăng nhập và là chủ sở hữu bản ghi
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Chỉ cho phép tạo mới nếu đăng nhập và dữ liệu hợp lệ
      allow create: if request.auth != null 
        && isValidMovie(request.resource.data);
      
      // Chỉ cho phép sửa nếu đúng chủ sở hữu và dữ liệu mới hợp lệ
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && isValidMovie(request.resource.data);
      
      // Chỉ cho phép xoá nếu đúng chủ sở hữu
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
  }
}
